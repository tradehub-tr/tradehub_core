{
	"name": "Store Subscription",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression (old style)",
	"autoname": "STSUB-.YYYY.-.#####",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"title_field": "store",
	"fields": [
		{
			"fieldname": "tab_basic",
			"fieldtype": "Tab Break",
			"label": "Subscription"
		},
		{
			"fieldname": "store",
			"fieldtype": "Link",
			"label": "Store (Admin Seller Profile)",
			"options": "Admin Seller Profile",
			"reqd": 1,
			"unique": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"description": "Bir mağaza için yalnızca tek aktif Store Subscription olabilir."
		},
		{
			"fieldname": "plan",
			"fieldtype": "Link",
			"label": "Plan",
			"options": "Subscription Plan",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "trial\nactive\npast_due\nexpired\ncanceled\nsuspended",
			"default": "active",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "cb_status",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "started_at",
			"fieldtype": "Datetime",
			"label": "Started At",
			"reqd": 1
		},
		{
			"fieldname": "current_period_start",
			"fieldtype": "Datetime",
			"label": "Current Period Start"
		},
		{
			"fieldname": "current_period_end",
			"fieldtype": "Datetime",
			"label": "Current Period End",
			"in_list_view": 1
		},
		{
			"fieldname": "trial_start",
			"fieldtype": "Datetime",
			"label": "Trial Start"
		},
		{
			"fieldname": "trial_end",
			"fieldtype": "Datetime",
			"label": "Trial End"
		},
		{
			"fieldname": "trial_plan",
			"fieldtype": "Link",
			"label": "Trial Plan",
			"options": "Subscription Plan",
			"description": "Deneme süresince açılan paket (genelde PRO)."
		},
		{
			"fieldname": "trial_used",
			"fieldtype": "Check",
			"label": "Trial Used",
			"default": "0",
			"description": "Bu mağaza deneme hakkını kullandı mı (1 mağaza = 1 trial)."
		},
		{
			"fieldname": "reminder_3d_sent",
			"fieldtype": "Check",
			"label": "Reminder 3d Sent",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "reminder_1d_sent",
			"fieldtype": "Check",
			"label": "Reminder 1d Sent",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "reminder_2h_sent",
			"fieldtype": "Check",
			"label": "Reminder 2h Sent",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "canceled_at",
			"fieldtype": "Datetime",
			"label": "Canceled At"
		},
		{
			"fieldname": "cancellation_reason",
			"fieldtype": "Long Text",
			"label": "Cancellation Reason"
		},
		{
			"fieldname": "tab_billing",
			"fieldtype": "Tab Break",
			"label": "Faturalama"
		},
		{
			"fieldname": "billing_cycle",
			"fieldtype": "Select",
			"label": "Billing Cycle",
			"options": "monthly\nyearly",
			"default": "monthly"
		},
		{
			"fieldname": "next_invoice_date",
			"fieldtype": "Date",
			"label": "Next Invoice Date"
		},
		{
			"fieldname": "tab_overrides",
			"fieldtype": "Tab Break",
			"label": "Özel Anlaşmalar (Override)"
		},
		{
			"fieldname": "custom_quota_overrides",
			"fieldtype": "JSON",
			"label": "Custom Quota Overrides",
			"description": "Plan'ın quota_limits üzerinde özel artışlar. Enterprise için. Örn: {\"quota.max_sub_users\": 50}"
		},
		{
			"fieldname": "custom_capability_overrides",
			"fieldtype": "JSON",
			"label": "Custom Capability Overrides",
			"description": "Plan'ın capability_flags üzerinde özel toggle'lar."
		},
		{
			"fieldname": "tab_history",
			"fieldtype": "Tab Break",
			"label": "Geçmiş"
		},
		{
			"fieldname": "previous_plan",
			"fieldtype": "Link",
			"label": "Previous Plan",
			"options": "Subscription Plan",
			"description": "Son upgrade/downgrade öncesi plan"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"export": 1,
			"report": 1,
			"share": 1
		},
		{
			"role": "Marketplace Admin",
			"read": 1,
			"write": 1,
			"create": 1
		},
		{
			"role": "Marketplace Seller",
			"read": 1,
			"write": 1,
			"if_owner": 1
		},
		{
			"role": "Seller",
			"read": 1,
			"if_owner": 1
		}
	]
}
