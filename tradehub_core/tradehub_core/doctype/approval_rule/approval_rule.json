{
	"name": "Approval Rule",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression (old style)",
	"autoname": "AR-.YYYY.-.######",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "min_amount",
	"sort_order": "ASC",
	"title_field": "rule_name",
	"fields": [
		{
			"fieldname": "tab_main",
			"fieldtype": "Tab Break",
			"label": "Kural"
		},
		{
			"fieldname": "rule_name",
			"fieldtype": "Data",
			"label": "Rule Name",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "organization",
			"fieldtype": "Link",
			"label": "Organization",
			"options": "CRM Organization",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"search_index": 1
		},
		{
			"fieldname": "is_active",
			"fieldtype": "Check",
			"label": "Active",
			"default": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "cb_amount",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "currency",
			"fieldtype": "Link",
			"label": "Currency",
			"options": "Currency",
			"default": "EUR",
			"reqd": 1
		},
		{
			"fieldname": "min_amount",
			"fieldtype": "Currency",
			"label": "Min Amount (inclusive)",
			"default": 0,
			"in_list_view": 1,
			"options": "currency"
		},
		{
			"fieldname": "max_amount",
			"fieldtype": "Currency",
			"label": "Max Amount (exclusive)",
			"in_list_view": 1,
			"options": "currency",
			"description": "Boş bırakılırsa üst sınır yok (catch-all)"
		},
		{
			"fieldname": "priority",
			"fieldtype": "Int",
			"label": "Priority",
			"default": 100,
			"description": "Aynı amount için çakışan kurallarda küçük olan ilk"
		},
		{
			"fieldname": "sb_filter",
			"fieldtype": "Section Break",
			"label": "Filtreler (opsiyonel)",
			"collapsible": 1
		},
		{
			"fieldname": "category_filter",
			"fieldtype": "Link",
			"label": "Category Filter",
			"options": "Product Category",
			"description": "Sadece bu kategoride yapılan sipariş; boş = her kategori"
		},
		{
			"fieldname": "supplier_filter",
			"fieldtype": "Link",
			"label": "Supplier Filter",
			"options": "Admin Seller Profile",
			"description": "Sadece bu satıcıya yapılan sipariş; boş = her satıcı"
		},
		{
			"fieldname": "tab_approvers",
			"fieldtype": "Tab Break",
			"label": "Onaylayıcılar"
		},
		{
			"fieldname": "approvers",
			"fieldtype": "Table",
			"label": "Approver Chain",
			"options": "Approval Rule Approver",
			"reqd": 1,
			"description": "Onay zinciri. Aynı level'da birden fazla user = OR (herhangi biri onaylar)."
		},
		{
			"fieldname": "sb_meta",
			"fieldtype": "Section Break",
			"label": "Meta"
		},
		{
			"fieldname": "description",
			"fieldtype": "Long Text",
			"label": "Description"
		},
		{
			"fieldname": "approval_timeout_days",
			"fieldtype": "Int",
			"label": "Timeout (gün)",
			"default": 7,
			"description": "Bu kadar gün içinde onaylanmazsa otomatik reddedilir (Faz 3 scheduler)"
		}
	],
	"permissions": [
		{ "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1 },
		{ "role": "Marketplace Admin", "read": 1, "write": 1, "create": 1 },
		{ "role": "Compliance Officer", "read": 1, "report": 1 },
		{ "role": "Buyer Admin", "read": 1, "write": 1, "create": 1 },
		{ "role": "Buyer Approver L1", "read": 1 },
		{ "role": "Buyer Approver L2", "read": 1 }
	]
}
