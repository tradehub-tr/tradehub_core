{
	"name": "Storefront Layout",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "By fieldname",
	"autoname": "field:seller_profile",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"title_field": "seller_profile",
	"fields": [
		{
			"fieldname": "seller_profile",
			"fieldtype": "Link",
			"label": "Seller Profile",
			"options": "Admin Seller Profile",
			"reqd": 1,
			"unique": 1,
			"set_only_once": 1,
			"search_index": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "cb_main",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "is_published",
			"fieldtype": "Check",
			"label": "Yayında",
			"default": "0",
			"in_list_view": 1
		},
		{
			"fieldname": "sb_layout",
			"fieldtype": "Section Break",
			"label": "Sayfa Düzeni"
		},
		{
			"fieldname": "sections",
			"fieldtype": "JSON",
			"label": "Bölüm Düzeni",
			"description": "Sayfadaki bölümlerin sırası, ayarları ve açık/kapalı durumu (JSON)"
		},
		{
			"fieldname": "sb_theme",
			"fieldtype": "Section Break",
			"label": "Tema Ayarları"
		},
		{
			"fieldname": "theme_config",
			"fieldtype": "JSON",
			"label": "Tema Konfigürasyonu",
			"description": "Renk, font ve genel görünüm ayarları (JSON)"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"permlevel": 0
		},
		{
			"role": "Marketplace Admin",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"permlevel": 0
		},
		{
			"role": "Seller",
			"read": 1,
			"write": 1,
			"create": 1,
			"permlevel": 0
		}
	]
}
