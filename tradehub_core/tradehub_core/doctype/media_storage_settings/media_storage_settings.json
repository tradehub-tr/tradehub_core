  {"fieldname":"cb_primary","fieldtype":"Column Break"},
  {"fieldname":"local_max_usage_gb","fieldtype":"Int","label":"Azami Yerel Kullanım (GB)","default":"0","description":"0 sınırsızdır; pozitif değer aşılırsa yeni yazma reddedilir."},
  {"fieldname":"change_reason","fieldtype":"Small Text","label":"Değişiklik Gerekçesi","description":"Sır içermemelidir; denetim kaydına yazılır."},

