 "fields": [
  {"fieldname":"sb_primary","fieldtype":"Section Break","label":"1 · Birincil Depolama","description":"Yerel Frappe dosya sistemi her zaman kullanılabilir kalır; diğer kipler açık adapter ayarlarıyla etkinleşir."},
  {"fieldname":"storage_mode","fieldtype":"Select","label":"Depolama Kipi","options":"local\nmirror\ns3_primary\ntiered","default":"local","reqd":1,"description":"local / mirror / s3_primary / tiered."},
  {"fieldname":"local_root","fieldtype":"Data","label":"Yerel Kök","length":255,"description":"Boşsa Frappe site public/files ve private/files kökleri kullanılır."},
