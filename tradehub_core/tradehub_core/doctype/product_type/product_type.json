{
 "name": "Product Type",
 "module": "Tradehub Core",
 "doctype": "DocType",
 "document_type": "Setup",
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "autoname": "field:type_code",
 "allow_rename": 1,
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "quick_entry": 1,
 "search_fields": "type_name,type_code",
 "show_name_in_global_search": 1,
 "title_field": "type_name",
 "sort_field": "type_name",
 "sort_order": "ASC",
 "field_order": [
  "tab_general",
  "sb_identity",
  "type_code",
  "type_name",
  "type_name_en",
  "is_active",
  "column_break_1",
  "parent_product_type",
  "icon_class",
  "sort_order",
  "sb_classification",
  "description",
  "category_hint",
  "tab_structure",
  "sb_attributes",
  "required_attributes",
  "sb_behaviors",
  "has_variants_default",
  "has_serial_number",
  "has_batch",
  "column_break_2",
  "is_digital",
  "is_service",
  "requires_shipping",
  "tab_seo",
  "sb_seo",
  "meta_title",
  "meta_description"
 ],
 "fields": [
  {"fieldname": "tab_general", "fieldtype": "Tab Break", "label": "Genel"},
  {"fieldname": "sb_identity", "fieldtype": "Section Break", "label": "Kimlik"},
  {"fieldname": "type_code", "fieldtype": "Data", "label": "Tip Kodu", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "type_name", "fieldtype": "Data", "label": "Tip Adı", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "type_name_en", "fieldtype": "Data", "label": "Type Name (EN)"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Aktif", "default": "1", "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "parent_product_type", "fieldtype": "Link", "label": "Üst Tip", "options": "Product Type"},
  {"fieldname": "icon_class", "fieldtype": "Data", "label": "İkon Sınıfı", "hidden": 1, "default": "package", "description": "Lucide ikon adı. Form'dan gizli — varsayılan 'package'; mevcut özel değerler (ör. ELECTRONICS=cpu) korunur."},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sıralama", "default": "0"},
  {"fieldname": "sb_classification", "fieldtype": "Section Break", "label": "Sınıflandırma"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Açıklama"},
  {"fieldname": "category_hint", "fieldtype": "Link", "label": "Varsayılan Kategori", "options": "Product Category", "description": "Bu tip için önerilen kategori"},
  {"fieldname": "tab_structure", "fieldtype": "Tab Break", "label": "Yapı"},
  {"fieldname": "sb_attributes", "fieldtype": "Section Break", "label": "Zorunlu Attribute'ler"},
  {"fieldname": "required_attributes", "fieldtype": "Table", "label": "Zorunlu Attribute'ler", "options": "Product Type Required Attribute"},
  {"fieldname": "sb_behaviors", "fieldtype": "Section Break", "label": "Davranışlar"},
  {"fieldname": "has_variants_default", "fieldtype": "Check", "label": "Varsayılan Varyantlı", "default": "0"},
  {"fieldname": "has_serial_number", "fieldtype": "Check", "label": "Seri Numaralı", "default": "0"},
  {"fieldname": "has_batch", "fieldtype": "Check", "label": "Parti Takipli", "default": "0"},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "is_digital", "fieldtype": "Check", "label": "Dijital Ürün", "default": "0"},
  {"fieldname": "is_service", "fieldtype": "Check", "label": "Hizmet", "default": "0"},
  {"fieldname": "requires_shipping", "fieldtype": "Check", "label": "Kargo Gerektirir", "default": "1"},
  {"fieldname": "tab_seo", "fieldtype": "Tab Break", "label": "SEO"},
  {"fieldname": "sb_seo", "fieldtype": "Section Break", "label": "SEO"},
  {"fieldname": "meta_title", "fieldtype": "Data", "label": "Meta Title"},
  {"fieldname": "meta_description", "fieldtype": "Small Text", "label": "Meta Description"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1, "report": 1, "share": 1, "print": 1, "email": 1},
  {"role": "Marketplace Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "Seller", "read": 1, "report": 1, "export": 1},
  {"role": "Marketplace Seller", "read": 1},
  {"role": "All", "read": 1}
 ]
}
