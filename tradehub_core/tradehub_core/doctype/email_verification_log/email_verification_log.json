{
	"name": "Email Verification Log",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression (old style)",
	"autoname": "format:EVL-{YYYY}-{MM}-{#####}",
	"engine": "InnoDB",
	"sort_field": "creation",
	"sort_order": "DESC",
	"track_changes": 0,
	"in_create": 1,
	"fields": [
		{
			"fieldname": "user",
			"fieldtype": "Link",
			"label": "User",
			"options": "User",
			"reqd": 1,
			"in_list_view": 1,
			"search_index": 1
		},
		{
			"fieldname": "event",
			"fieldtype": "Select",
			"label": "Event",
			"options": "verified\nunverified\nchange_requested\nchange_completed\nadmin_override",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "method",
			"fieldtype": "Select",
			"label": "Method",
			"options": "\notp\nadmin_override\nmigration",
			"in_list_view": 1
		},
		{
			"fieldname": "cb_meta",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "actor",
			"fieldtype": "Link",
			"label": "Actor",
			"options": "User",
			"in_list_view": 1
		},
		{
			"fieldname": "ip_address",
			"fieldtype": "Data",
			"label": "IP Address"
		},
		{
			"fieldname": "user_agent",
			"fieldtype": "Small Text",
			"label": "User Agent"
		},
		{
			"fieldname": "sb_reason",
			"fieldtype": "Section Break",
			"label": "Reason"
		},
		{
			"fieldname": "reason",
			"fieldtype": "Small Text",
			"label": "Reason"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"create": 1,
			"export": 1,
			"report": 1
		},
		{
			"role": "Marketplace Admin",
			"read": 1,
			"export": 1,
			"report": 1
		}
	],
	"actions": [],
	"links": [],
	"states": []
}
