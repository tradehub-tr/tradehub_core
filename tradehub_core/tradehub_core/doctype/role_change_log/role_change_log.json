{
	"name": "Role Change Log",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression (old style)",
	"autoname": "RCL-.YYYY.MM.DD.-.######",
	"engine": "InnoDB",
	"track_changes": 0,
	"sort_field": "timestamp",
	"sort_order": "DESC",
	"title_field": "target_user",
	"fields": [
		{
			"fieldname": "timestamp",
			"fieldtype": "Datetime",
			"label": "Timestamp",
			"reqd": 1,
			"search_index": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"read_only": 1
		},
		{
			"fieldname": "change_type",
			"fieldtype": "Select",
			"label": "Change Type",
			"options": "invite\nactivate\ndeactivate\nrole_assign\nrole_remove\nprofile_change\nco_owner_promote\nowner_transfer",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"read_only": 1
		},
		{
			"fieldname": "cb_actor",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "changed_by",
			"fieldtype": "Link",
			"label": "Changed By",
			"options": "User",
			"reqd": 1,
			"search_index": 1,
			"in_list_view": 1,
			"read_only": 1
		},
		{
			"fieldname": "target_user",
			"fieldtype": "Link",
			"label": "Target User",
			"options": "User",
			"reqd": 1,
			"search_index": 1,
			"in_list_view": 1,
			"read_only": 1
		},
		{
			"fieldname": "tenant",
			"fieldtype": "Link",
			"label": "Tenant",
			"options": "Admin Seller Profile",
			"in_standard_filter": 1,
			"read_only": 1
		},
		{
			"fieldname": "sb_roles",
			"fieldtype": "Section Break",
			"label": "Roles"
		},
		{
			"fieldname": "before_roles",
			"fieldtype": "JSON",
			"label": "Before Roles",
			"read_only": 1
		},
		{
			"fieldname": "after_roles",
			"fieldtype": "JSON",
			"label": "After Roles",
			"read_only": 1
		},
		{
			"fieldname": "cb_profiles",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "before_role_profiles",
			"fieldtype": "JSON",
			"label": "Before Role Profiles",
			"read_only": 1
		},
		{
			"fieldname": "after_role_profiles",
			"fieldtype": "JSON",
			"label": "After Role Profiles",
			"read_only": 1
		},
		{
			"fieldname": "sb_meta",
			"fieldtype": "Section Break",
			"label": "Meta"
		},
		{
			"fieldname": "reason",
			"fieldtype": "Small Text",
			"label": "Reason",
			"read_only": 1
		},
		{
			"fieldname": "is_temporary",
			"fieldtype": "Check",
			"label": "Is Temporary",
			"default": 0,
			"read_only": 1
		},
		{
			"fieldname": "auto_revert_at",
			"fieldtype": "Datetime",
			"label": "Auto Revert At",
			"read_only": 1
		}
	],
	"permissions": [
		{ "role": "System Manager", "read": 1, "export": 1, "report": 1 },
		{ "role": "Marketplace Admin", "read": 1, "report": 1 },
		{ "role": "Compliance Officer", "read": 1, "export": 1, "report": 1 },
		{ "role": "Marketplace Seller", "read": 1, "if_owner": 1 },
		{ "role": "Seller", "read": 1, "if_owner": 1 }
	]
}
