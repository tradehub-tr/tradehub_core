{
 "name": "Product Attribute",
 "module": "Tradehub Core",
 "doctype": "DocType",
 "document_type": "Setup",
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "autoname": "field:attribute_code",
 "allow_rename": 1,
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "quick_entry": 1,
 "search_fields": "attribute_label,attribute_code",
 "show_name_in_global_search": 1,
 "title_field": "attribute_label",
 "sort_field": "attribute_label",
 "sort_order": "ASC",
 "field_order": [
  "tab_general",
  "sb_identity",
  "attribute_code",
  "attribute_label",
  "attribute_label_en",
  "attribute_group",
  "is_active",
  "column_break_1",
  "data_type",
  "unit_of_measure",
  "display_order",
  "sb_usage",
  "is_variant_axis",
  "is_filterable",
  "is_searchable",
  "is_comparable",
  "column_break_2",
  "is_required_default",
  "is_translatable",
  "is_public",
  "include_in_bulk_template",
  "tab_validation",
  "sb_constraints",
  "min_value",
  "max_value",
  "regex_pattern",
  "column_break_3",
  "default_value",
  "validation_message",
  "sb_select_options",
  "value_options",
  "tab_display",
  "sb_display",
  "description",
  "help_text",
  "icon_class"
 ],
 "fields": [
  {"fieldname": "tab_general", "fieldtype": "Tab Break", "label": "Genel"},
  {"fieldname": "sb_identity", "fieldtype": "Section Break", "label": "Kimlik"},
  {"fieldname": "attribute_code", "fieldtype": "Data", "label": "Attribute Kodu", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "attribute_label", "fieldtype": "Data", "label": "Etiket", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "attribute_label_en", "fieldtype": "Data", "label": "Attribute Label (EN)"},
  {"fieldname": "attribute_group", "fieldtype": "Data", "label": "Grup", "description": "Örn: Temel Özellikler, Paketleme, Teknik"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Aktif", "default": "1", "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "data_type", "fieldtype": "Select", "label": "Veri Tipi", "options": "Text\nLong Text\nNumber\nInteger\nDecimal\nBoolean\nDate\nDatetime\nSelect\nMulti-Select\nColor\nURL\nEmail\nPhone", "default": "Text", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "unit_of_measure", "fieldtype": "Data", "label": "Birim", "description": "cm, kg, L, vb."},
  {"fieldname": "display_order", "fieldtype": "Int", "label": "Görüntü Sırası", "default": "0"},
  {"fieldname": "sb_usage", "fieldtype": "Section Break", "label": "Kullanım"},
  {"fieldname": "is_variant_axis", "fieldtype": "Check", "label": "Varyant Ekseni", "default": "0", "description": "Renk, Beden gibi varyant ayrımı sağlar"},
  {"fieldname": "is_filterable", "fieldtype": "Check", "label": "Filtrelenebilir", "default": "0"},
  {"fieldname": "is_searchable", "fieldtype": "Check", "label": "Aranabilir", "default": "0"},
  {"fieldname": "is_comparable", "fieldtype": "Check", "label": "Karşılaştırılabilir", "default": "0"},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "is_required_default", "fieldtype": "Check", "label": "Varsayılan Zorunlu", "default": "0"},
  {"fieldname": "is_translatable", "fieldtype": "Check", "label": "Çevrilebilir", "default": "0"},
  {"fieldname": "is_public", "fieldtype": "Check", "label": "Alıcıya Görünür", "default": "1"},
  {"fieldname": "include_in_bulk_template", "fieldtype": "Check", "label": "Include in Bulk Template", "default": "0"},
  {"fieldname": "tab_validation", "fieldtype": "Tab Break", "label": "Doğrulama"},
  {"fieldname": "sb_constraints", "fieldtype": "Section Break", "label": "Kısıtlar"},
  {"fieldname": "min_value", "fieldtype": "Data", "label": "Min Değer", "depends_on": "eval:['Number','Integer','Decimal','Date','Datetime'].includes(doc.data_type)"},
  {"fieldname": "max_value", "fieldtype": "Data", "label": "Max Değer", "depends_on": "eval:['Number','Integer','Decimal','Date','Datetime'].includes(doc.data_type)"},
  {"fieldname": "regex_pattern", "fieldtype": "Data", "label": "Regex Kalıbı", "depends_on": "eval:['Text','URL','Email','Phone'].includes(doc.data_type)"},
  {"fieldname": "column_break_3", "fieldtype": "Column Break"},
  {"fieldname": "default_value", "fieldtype": "Data", "label": "Varsayılan Değer"},
  {"fieldname": "validation_message", "fieldtype": "Small Text", "label": "Hata Mesajı"},
  {"fieldname": "sb_select_options", "fieldtype": "Section Break", "label": "Select/Multi-Select Değerleri", "depends_on": "eval:['Select','Multi-Select','Color'].includes(doc.data_type)"},
  {"fieldname": "value_options", "fieldtype": "Table", "label": "Değer Seçenekleri", "options": "Product Attribute Value Option"},
  {"fieldname": "tab_display", "fieldtype": "Tab Break", "label": "Görüntü"},
  {"fieldname": "sb_display", "fieldtype": "Section Break", "label": "Görüntü"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Açıklama"},
  {"fieldname": "help_text", "fieldtype": "Small Text", "label": "Yardım Metni"},
  {"fieldname": "icon_class", "fieldtype": "Data", "label": "İkon Sınıfı"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1, "report": 1, "share": 1, "print": 1, "email": 1},
  {"role": "Marketplace Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "Seller", "read": 1, "write": 1, "create": 1, "delete": 1, "if_owner": 1, "report": 1, "export": 1},
  {"role": "Marketplace Seller", "read": 1, "write": 1, "create": 1, "delete": 1, "if_owner": 1},
  {"role": "All", "read": 1}
 ]
}
