{
	"name": "Seller Sub User Invite",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression (old style)",
	"autoname": "SSUI-.YYYY.MM.DD.-.######",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "creation",
	"sort_order": "DESC",
	"title_field": "email",
	"fields": [
		{
			"fieldname": "tab_main",
			"fieldtype": "Tab Break",
			"label": "Davet"
		},
		{
			"fieldname": "email",
			"fieldtype": "Data",
			"label": "Email",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"options": "Email"
		},
		{
			"fieldname": "full_name",
			"fieldtype": "Data",
			"label": "Full Name",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "tenant",
			"fieldtype": "Link",
			"label": "Tenant (Admin Seller Profile)",
			"options": "Admin Seller Profile",
			"reqd": 1,
			"search_index": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "role_profile",
			"fieldtype": "Link",
			"label": "Role Profile",
			"options": "Role Profile",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "cb_status",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "Pending\nAccepted\nExpired\nRevoked",
			"default": "Pending",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"read_only": 1
		},
		{
			"fieldname": "invited_by",
			"fieldtype": "Link",
			"label": "Invited By",
			"options": "User",
			"read_only": 1
		},
		{
			"fieldname": "expires_at",
			"fieldtype": "Datetime",
			"label": "Expires At",
			"reqd": 1,
			"read_only": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "accepted_at",
			"fieldtype": "Datetime",
			"label": "Accepted At",
			"read_only": 1
		},
		{
			"fieldname": "created_user",
			"fieldtype": "Link",
			"label": "Created User",
			"options": "User",
			"read_only": 1,
			"description": "Davet kabul edildikten sonra oluşturulan User"
		},
		{
			"fieldname": "sb_token",
			"fieldtype": "Section Break",
			"label": "Token (gizli)",
			"collapsible": 1
		},
		{
			"fieldname": "token_hash",
			"fieldtype": "Data",
			"label": "Token Hash",
			"read_only": 1,
			"description": "SHA-256 hash; raw token sadece e-postada görünür"
		},
		{
			"fieldname": "revoke_reason",
			"fieldtype": "Small Text",
			"label": "Revoke Reason",
			"read_only": 1,
			"depends_on": "eval:doc.status === 'Revoked'"
		}
	],
	"permissions": [
		{ "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1 },
		{ "role": "Marketplace Admin", "read": 1, "write": 1, "create": 1, "report": 1 },
		{ "role": "Marketplace Seller", "read": 1, "if_owner": 1 },
		{ "role": "Seller", "read": 1, "if_owner": 1 }
	]
}
