  {"role": "Marketplace Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "Seller", "read": 1, "write": 1, "create": 1, "delete": 1, "if_owner": 1, "report": 1, "export": 1, "print": 1, "email": 1},
  {"role": "Marketplace Seller", "read": 1, "write": 1, "create": 1, "delete": 1, "if_owner": 1},
  {"role": "All", "read": 1}
 ]
