  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sıralama", "default": "0"},
  {"fieldname": "sb_desc", "fieldtype": "Section Break", "label": "Açıklama"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Açıklama"},
  {"fieldname": "tab_lineage", "fieldtype": "Tab Break", "label": "Soyağacı"},
