			"fieldname": "sb_email_verification",
			"fieldtype": "Section Break",
			"label": "E-posta Doğrulama"
		},
		{
			"fieldname": "email_verified",
			"fieldtype": "Check",
			"label": "Email Verified",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "email_verified_at",
			"fieldtype": "Datetime",
			"label": "Email Verified At",
			"read_only": 1,
			"depends_on": "eval:doc.email_verified"
		},
		{
			"fieldname": "cb_email",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "email_verified_method",
			"fieldtype": "Select",
			"label": "Email Verified Method",
			"options": "\notp\nadmin_override\nmigration",
			"read_only": 1,
			"depends_on": "eval:doc.email_verified"
		},
		{
			"fieldname": "sb_kyc",
			"fieldtype": "Section Break",
			"label": "KYC (Alıcı Doğrulama)"
		},
		{
			"fieldname": "kyc_status",
			"fieldtype": "Select",
			"label": "KYC Status",
			"options": "\nLocked\nPending\nVerified\nRejected\nSuspended",
			"read_only": 1,
			"description": "Locked: Satıcı kayıt akışı (Alıcı olmak için doldurulmadı). Sprint 2.6"
		},
		{
			"fieldname": "cb_kyc",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "kyc_verified_at",
			"fieldtype": "Datetime",
			"label": "KYC Verified At",
			"read_only": 1
		},
		{
			"fieldname": "sb_kyb",
			"fieldtype": "Section Break",
			"label": "KYB (Satıcı Doğrulama)"
		},
		{
			"fieldname": "kyb_status",
			"fieldtype": "Select",
			"label": "KYB Status",
			"options": "\nLocked\nPending\nUnder Review\nVerified\nRejected\nSuspended",
			"read_only": 1,
			"permlevel": 1,
			"description": "Locked: Alıcı kayıt akışı (Satıcı başvurusu yapılmadı). Sprint 2.6"
		},
		{
			"fieldname": "cb_kyb",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "kyb_verified_at",
			"fieldtype": "Datetime",
			"label": "KYB Verified At",
			"read_only": 1,
			"permlevel": 1
		},
		{
			"fieldname": "tab_bank",
			"fieldtype": "Tab Break",
			"label": "Banka",
			"depends_on": "eval:doc.can_sell"
		},
		{
			"fieldname": "bank_name",
			"fieldtype": "Data",
			"label": "Bank Name",
			"permlevel": 1
