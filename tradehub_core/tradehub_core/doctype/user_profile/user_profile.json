{
	"name": "User Profile",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "By fieldname",
	"autoname": "field:user",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"title_field": "full_name",
	"search_fields": "full_name,member_id",
	"fields": [
		{
			"fieldname": "tab_account",
			"fieldtype": "Tab Break",
			"label": "Hesap"
		},
		{
			"fieldname": "user",
			"fieldtype": "Link",
			"label": "User",
			"options": "User",
			"reqd": 1,
			"unique": 1,
			"set_only_once": 1,
			"search_index": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "member_id",
			"fieldtype": "Data",
			"label": "Member ID",
			"read_only": 1,
			"in_list_view": 1,
			"bold": 1,
			"description": "Sistem tarafından üretilen üyelik numarası (UP-XXXXXX)"
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "Active\nSuspended\nDeactivated",
			"default": "Active",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "cb_capabilities",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "can_buy",
			"fieldtype": "Check",
			"label": "Can Buy",
			"default": "1",
			"in_standard_filter": 1,
			"description": "Kullanıcı storefront'tan alışveriş yapabilir"
		},
		{
			"fieldname": "can_sell",
			"fieldtype": "Check",
			"label": "Can Sell",
			"default": "0",
			"in_standard_filter": 1,
			"description": "Kullanıcı admin-panel'de mağaza yönetebilir (KYB Verified zorunlu)"
		},
		{
			"fieldname": "can_admin",
			"fieldtype": "Check",
			"label": "Can Admin",
			"default": "0",
			"read_only": 1,
			"description": "Platform admin rolünden türetilir (otomatik)"
		},
		{
			"fieldname": "sb_basic",
			"fieldtype": "Section Break",
			"label": "Temel Bilgiler"
		},
		{
			"fieldname": "full_name",
			"fieldtype": "Data",
			"label": "Full Name",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "phone",
			"fieldtype": "Data",
			"label": "Phone",
			"options": "Phone"
		},
		{
			"fieldname": "cb_basic",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "country",
			"fieldtype": "Link",
			"label": "Country",
			"options": "Country"
		},
		{
			"fieldname": "tenant",
			"fieldtype": "Data",
			"label": "Tenant (Sprint 3)",
			"read_only": 1,
			"description": "Multi-tenant aktivasyonu Sprint 3'te. Şu an placeholder."
		},
		{
			"fieldname": "tab_identity",
			"fieldtype": "Tab Break",
			"label": "Kimlik & Doğrulama"
		},
		{
			"fieldname": "account_type",
			"fieldtype": "Select",
			"label": "Account Type",
			"options": "Individual\nBusiness",
			"reqd": 1,
			"default": "Individual",
			"in_standard_filter": 1,
			"description": "Bireysel veya Kurumsal. can_sell=1 ise Business ZORUNLU. Individual → Business upgrade TEK YÖNLÜDÜR."
		},
		{
			"fieldname": "company_name",
			"fieldtype": "Data",
			"label": "Company Name",
			"mandatory_depends_on": "eval:doc.account_type=='Business'"
		},
		{
			"fieldname": "tax_id",
			"fieldtype": "Data",
			"label": "Tax ID",
			"permlevel": 1,
			"mandatory_depends_on": "eval:doc.account_type=='Business'"
		},
		{
			"fieldname": "tax_id_type",
			"fieldtype": "Select",
			"label": "Tax ID Type",
			"options": "\nTCKN\nVKN",
			"permlevel": 1
		},
		{
			"fieldname": "cb_identity",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "tax_office",
			"fieldtype": "Data",
			"label": "Tax Office",
			"permlevel": 1
		},
