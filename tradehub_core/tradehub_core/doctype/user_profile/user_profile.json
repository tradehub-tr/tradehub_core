		{
			"fieldname": "iban",
			"fieldtype": "Data",
			"label": "IBAN",
			"permlevel": 1
		},
		{
			"fieldname": "cb_bank",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "account_holder_name",
			"fieldtype": "Data",
			"label": "Account Holder Name",
			"permlevel": 1
		},
