{
	"name": "TH Capability Grant",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "By fieldname",
	"autoname": "format:GRT-{role_profile}-{capability}",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "role_profile",
	"sort_order": "ASC",
	"fields": [
		{
			"fieldname": "role_profile",
			"fieldtype": "Link",
			"label": "Role Profile",
			"options": "Role Profile",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "capability",
			"fieldtype": "Link",
			"label": "Capability",
			"options": "TH Capability Registry",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "granted",
			"fieldtype": "Check",
			"label": "Verildi",
			"default": 1,
			"in_list_view": 1,
			"description": "Tier default'a override: false = 'tier verirdi ama biz çekiyoruz'"
		},
		{
			"fieldname": "cb_audit",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "expires_at",
			"fieldtype": "Datetime",
			"label": "Sona Erme",
			"description": "Geçici grant — null ise kalıcı"
		},
		{
			"fieldname": "granted_by",
			"fieldtype": "Link",
			"label": "Veren",
			"options": "User",
			"read_only": 1
		},
		{
			"fieldname": "granted_at",
			"fieldtype": "Datetime",
			"label": "Verilme Zamanı",
			"read_only": 1
		},
		{
			"fieldname": "sb_note",
			"fieldtype": "Section Break",
			"label": "Gerekçe"
		},
		{
			"fieldname": "note",
			"fieldtype": "Small Text",
			"label": "Gerekçe",
			"description": "Süper admin neden bu grant'i verdi/çekti — audit için"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "share": 1
		},
		{
			"role": "Marketplace Admin",
			"read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "share": 1
		}
	]
}
