{
	"name": "Pricing Plan Feature",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"istable": 1,
	"editable_grid": 1,
	"engine": "InnoDB",
	"track_changes": 0,
	"fields": [
		{
			"fieldname": "display_text",
			"fieldtype": "Data",
			"label": "Görünen Metin",
			"reqd": 1,
			"in_list_view": 1,
			"description": "Pricing card'da gösterilecek satır (örn. '4 dilli vitrin · TR · EN · DE · FR')"
		},
		{
			"fieldname": "icon",
			"fieldtype": "Select",
			"label": "İkon",
			"options": "check\nx\ninfo\nstar\nzap",
			"default": "check",
			"in_list_view": 1
		},
		{
			"fieldname": "is_disabled",
			"fieldtype": "Check",
			"label": "Bu Planda Kapalı",
			"default": 0,
			"in_list_view": 1,
			"description": "1 ise üstü çizili / gri gösterilir (örn. 'Hesap yöneticisi yok')"
		},
		{
			"fieldname": "feature_key",
			"fieldtype": "Link",
			"label": "Feature Catalog Link (opsiyonel)",
			"options": "Feature Catalog",
			"description": "Set edilirse plan'a abone olunca capability_flags'e otomatik eklenir"
		},
		{
			"fieldname": "sort_order",
			"fieldtype": "Int",
			"label": "Sıra",
			"default": 0
		},
		{
			"fieldname": "tooltip",
			"fieldtype": "Small Text",
			"label": "Tooltip (opsiyonel)",
			"description": "Hover'da gösterilecek ek açıklama"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1, "write": 1, "create": 1, "delete": 1
		}
	]
}
