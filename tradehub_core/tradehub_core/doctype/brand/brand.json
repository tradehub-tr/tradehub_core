{
 "name": "Brand",
 "module": "Tradehub Core",
 "doctype": "DocType",
 "document_type": "Setup",
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "autoname": "field:brand_code",
 "allow_rename": 1,
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "quick_entry": 1,
 "search_fields": "brand_name,brand_code",
 "show_name_in_global_search": 1,
 "title_field": "brand_name",
 "sort_field": "brand_name",
 "sort_order": "ASC",
 "field_order": [
  "tab_general",
  "sb_identity",
  "brand_code",
  "brand_name",
  "slug",
  "parent_brand",
  "column_break_1",
  "logo",
  "is_active",
  "sort_order",
  "sb_approval",
  "status",
  "suggested_by",
  "reviewed_by",
  "column_break_approval",
  "reviewed_at",
  "rejection_reason",
  "sb_meta",
  "description",
  "tab_compliance",
  "sb_verification",
  "official_status",
  "brand_owner",
  "verification_date",
  "verified_by",
  "column_break_2",
  "country",
  "founded_year",
  "website",
  "tab_storefront",
  "sb_hero",
  "tagline",
  "hero_banner",
  "column_break_hero",
  "theme_color",
  "video_url",
  "sb_about",
  "about_title",
  "about_content",
  "sb_featured",
  "featured_listings",
  "sb_social",
  "instagram_url",
  "facebook_url",
  "twitter_url",
  "column_break_social",
  "linkedin_url",
  "youtube_url",
  "tab_seo",
  "sb_seo",
  "meta_title",
  "meta_description"
 ],
 "fields": [
  {"fieldname": "tab_general", "fieldtype": "Tab Break", "label": "Genel"},
  {"fieldname": "sb_identity", "fieldtype": "Section Break", "label": "Kimlik"},
  {"fieldname": "brand_code", "fieldtype": "Data", "label": "Marka Kodu", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "Unique kod (autoname)"},
  {"fieldname": "brand_name", "fieldtype": "Data", "label": "Marka Adı", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "slug", "fieldtype": "Data", "label": "URL Slug", "unique": 1},
  {"fieldname": "parent_brand", "fieldtype": "Link", "label": "Üst Marka", "options": "Brand"},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "logo", "fieldtype": "Attach Image", "label": "Logo"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Aktif", "default": "1", "in_list_view": 1},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sıralama", "default": "0"},
  {"fieldname": "sb_approval", "fieldtype": "Section Break", "label": "Onay Durumu"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Onay Durumu", "options": "Pending Approval\nApproved\nRejected", "default": "Pending Approval", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "Satıcı tarafından oluşturulan markalar admin onayı bekler. Sadece System Manager / Marketplace Admin değiştirebilir."},
  {"fieldname": "suggested_by", "fieldtype": "Link", "label": "Öneren Satıcı", "options": "User", "read_only": 1, "ignore_user_permissions": 1, "in_standard_filter": 1},
  {"fieldname": "reviewed_by", "fieldtype": "Link", "label": "İnceleyen", "options": "User", "read_only": 1, "ignore_user_permissions": 1},
  {"fieldname": "column_break_approval", "fieldtype": "Column Break"},
  {"fieldname": "reviewed_at", "fieldtype": "Datetime", "label": "İnceleme Tarihi", "read_only": 1},
  {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Ret Gerekçesi", "depends_on": "eval:doc.status=='Rejected'", "mandatory_depends_on": "eval:doc.status=='Rejected'"},
  {"fieldname": "sb_meta", "fieldtype": "Section Break", "label": "Açıklama"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Açıklama"},
  {"fieldname": "tab_compliance", "fieldtype": "Tab Break", "label": "Doğrulama"},
  {"fieldname": "sb_verification", "fieldtype": "Section Break", "label": "Resmiyet"},
  {"fieldname": "official_status", "fieldtype": "Select", "label": "Resmi Durum", "options": "Verified\nPending\nUnverified", "default": "Unverified", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "Verified = marka sahibi doğrulandı, sayfayı kendi düzenleyebilir."},
  {"fieldname": "brand_owner", "fieldtype": "Link", "label": "Marka Sahibi (Satıcı)", "options": "Admin Seller Profile", "description": "Bu markanın IP sahibi satıcı. Sadece admin atar. brand_owner=X olan satıcı brand sayfasını düzenleyebilir."},
  {"fieldname": "verification_date", "fieldtype": "Date", "label": "Doğrulama Tarihi"},
  {"fieldname": "verified_by", "fieldtype": "Link", "label": "Doğrulayan", "options": "User", "read_only": 1, "ignore_user_permissions": 1},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "country", "fieldtype": "Link", "label": "Menşei Ülke", "options": "Country"},
  {"fieldname": "founded_year", "fieldtype": "Int", "label": "Kuruluş Yılı"},
  {"fieldname": "website", "fieldtype": "Data", "label": "Web Sitesi", "options": "URL"},
  {"fieldname": "tab_storefront", "fieldtype": "Tab Break", "label": "Vitrin"},
  {"fieldname": "sb_hero", "fieldtype": "Section Break", "label": "Hero"},
  {"fieldname": "tagline", "fieldtype": "Data", "label": "Slogan", "description": "Marka adının altında görünen kısa slogan (örn. \"Just Do It\")"},
  {"fieldname": "hero_banner", "fieldtype": "Attach Image", "label": "Hero Banner", "description": "Marka sayfası üstündeki geniş görsel (önerilen 1920×400)"},
  {"fieldname": "column_break_hero", "fieldtype": "Column Break"},
  {"fieldname": "theme_color", "fieldtype": "Color", "label": "Tema Rengi", "description": "Marka sayfasındaki vurgu rengi"},
  {"fieldname": "video_url", "fieldtype": "Data", "label": "Tanıtım Video URL", "description": "YouTube/Vimeo embed URL"},
  {"fieldname": "sb_about", "fieldtype": "Section Break", "label": "Hakkımızda"},
  {"fieldname": "about_title", "fieldtype": "Data", "label": "Başlık", "default": "Hakkımızda"},
  {"fieldname": "about_content", "fieldtype": "Text Editor", "label": "İçerik", "description": "Marka hikayesi / zengin metin"},
  {"fieldname": "sb_featured", "fieldtype": "Section Break", "label": "Öne Çıkan Ürünler"},
  {"fieldname": "featured_listings", "fieldtype": "Table", "label": "Öne Çıkan Ürünler", "options": "Brand Featured Listing", "description": "Marka sayfasının üstünde gösterilecek ürünler (max 8)"},
  {"fieldname": "sb_social", "fieldtype": "Section Break", "label": "Sosyal Medya"},
  {"fieldname": "instagram_url", "fieldtype": "Data", "label": "Instagram URL", "options": "URL"},
  {"fieldname": "facebook_url", "fieldtype": "Data", "label": "Facebook URL", "options": "URL"},
  {"fieldname": "twitter_url", "fieldtype": "Data", "label": "Twitter / X URL", "options": "URL"},
  {"fieldname": "column_break_social", "fieldtype": "Column Break"},
  {"fieldname": "linkedin_url", "fieldtype": "Data", "label": "LinkedIn URL", "options": "URL"},
  {"fieldname": "youtube_url", "fieldtype": "Data", "label": "YouTube URL", "options": "URL"},
  {"fieldname": "tab_seo", "fieldtype": "Tab Break", "label": "SEO"},
  {"fieldname": "sb_seo", "fieldtype": "Section Break", "label": "SEO Bilgileri"},
  {"fieldname": "meta_title", "fieldtype": "Data", "label": "Meta Title"},
  {"fieldname": "meta_description", "fieldtype": "Small Text", "label": "Meta Description"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1, "report": 1, "share": 1, "print": 1, "email": 1},
  {"role": "Marketplace Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "Seller", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1, "email": 1},
  {"role": "Marketplace Seller", "read": 1, "write": 1, "create": 1},
  {"role": "All", "read": 1}
 ]
}
