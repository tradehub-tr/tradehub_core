    {"fieldname": "weight_complementary_coview", "fieldtype": "Float", "label": "Co-view", "default": "0.30", "precision": "3"},
    {"fieldname": "cb_complementary", "fieldtype": "Column Break"},
    {"fieldname": "weight_complementary_embedding", "fieldtype": "Float", "label": "Kategori Embedding (cold-start fallback)", "default": "0.20", "precision": "3"},

    {"fieldname": "sb_accessory", "fieldtype": "Section Break", "label": "Aksesuar - Skor Ağırlıkları"},
    {"fieldname": "weight_accessory_token", "fieldtype": "Float", "label": "Token Eşleşmesi (için/uyumlu/compatible)", "default": "0.40", "precision": "3"},
    {"fieldname": "weight_accessory_price_ratio", "fieldtype": "Float", "label": "Fiyat Oranı", "default": "0.30", "precision": "3"},
