    {"fieldname": "embedding_cosine_threshold", "fieldtype": "Float", "label": "Embedding Cosine Eşiği", "default": "0.6", "precision": "3"},

    {"fieldname": "sb_similar", "fieldtype": "Section Break", "label": "Benzer - Skor Ağırlıkları"},
    {"fieldname": "weight_similar_category", "fieldtype": "Float", "label": "Kategori Eşleşmesi", "default": "0.40", "precision": "3"},
