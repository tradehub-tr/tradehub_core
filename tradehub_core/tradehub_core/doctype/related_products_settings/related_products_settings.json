    {"fieldname": "weight_substitute_different_seller", "fieldtype": "Float", "label": "Farklı Satıcı Bonusu", "default": "0.25", "precision": "3"},
    {"fieldname": "cb_substitute", "fieldtype": "Column Break"},
    {"fieldname": "weight_substitute_attribute", "fieldtype": "Float", "label": "Attribute Benzerliği", "default": "0.25", "precision": "3"},
    {"fieldname": "weight_substitute_price_proximity", "fieldtype": "Float", "label": "Fiyat Yakınlığı", "default": "0.20", "precision": "3"},

    {"fieldname": "sb_complementary", "fieldtype": "Section Break", "label": "Tamamlayıcı - Skor Ağırlıkları"},
