{
	"name": "Owner Transfer Request",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Autoincrement",
	"autoname": "format:OTR-{####}",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"fields": [
		{
			"fieldname": "tenant",
			"fieldtype": "Link",
			"label": "Tenant",
			"options": "Admin Seller Profile",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "current_owner",
			"fieldtype": "Link",
			"label": "Current Owner",
			"options": "User",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "proposed_owner",
			"fieldtype": "Link",
			"label": "Proposed Owner",
			"options": "User",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "cb_meta",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "draft\nawaiting_owner_confirm\nawaiting_super_admin\ncompleted\nrejected\ncancelled",
			"default": "draft",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "effective_at",
			"fieldtype": "Datetime",
			"label": "Effective At",
			"description": "Devir tamamlandığı an"
		},
		{
			"fieldname": "sb_approval",
			"fieldtype": "Section Break",
			"label": "Approval Trail"
		},
		{
			"fieldname": "owner_confirmed_at",
			"fieldtype": "Datetime",
			"label": "Owner Confirmed At"
		},
		{
			"fieldname": "super_admin_approved_at",
			"fieldtype": "Datetime",
			"label": "Super Admin Approved At"
		},
		{
			"fieldname": "super_admin_approved_by",
			"fieldtype": "Link",
			"label": "Super Admin Approved By",
			"options": "User"
		},
		{
			"fieldname": "is_force_transfer",
			"fieldtype": "Check",
			"label": "Force Transfer (Acil Müdahale)",
			"default": 0,
			"description": "Owner erişimsiz/kayıp ise System Manager direkt devreder"
		},
		{
			"fieldname": "sb_reason",
			"fieldtype": "Section Break",
			"label": "Reason"
		},
		{
			"fieldname": "reason",
			"fieldtype": "Text",
			"label": "Reason"
		},
		{
			"fieldname": "rejection_reason",
			"fieldtype": "Small Text",
			"label": "Rejection Reason"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "share": 1
		},
		{
			"role": "Seller Owner",
			"read": 1, "write": 1, "create": 1
		},
		{
			"role": "Compliance Officer",
			"read": 1, "report": 1
		}
	]
}
