{
	"name": "RFQ Quote",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression (old style)",
	"autoname": "RFQ-Q-.#####",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"fields": [
		{
			"fieldname": "tab_details",
			"fieldtype": "Tab Break",
			"label": "Details"
		},
		{
			"fieldname": "rfq",
			"fieldtype": "Link",
			"label": "RFQ",
			"options": "RFQ",
			"reqd": 1,
			"in_list_view": 1,
			"search_index": 1
		},
		{
			"fieldname": "seller",
			"fieldtype": "Link",
			"label": "Seller",
			"options": "User",
			"reqd": 1,
			"in_list_view": 1,
			"search_index": 1
		},
		{
			"fieldname": "seller_profile",
			"fieldtype": "Link",
			"label": "Seller Store",
			"options": "Admin Seller Profile",
			"description": "Sprint 2 - Admin Seller Profile (mağaza) Link"
		},
		{
			"fieldname": "cb_status",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "Submitted\nAccepted\nRejected\nWithdrawn",
			"default": "Submitted",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "tab_pricing",
			"fieldtype": "Tab Break",
			"label": "Pricing"
		},
		{
			"fieldname": "price_per_unit",
			"fieldtype": "Currency",
			"label": "Price per Unit"
		},
		{
			"fieldname": "total_price",
			"fieldtype": "Currency",
			"label": "Total Price",
			"in_list_view": 1
		},
		{
			"fieldname": "currency",
			"fieldtype": "Link",
			"label": "Currency",
			"options": "Currency"
		},
		{
			"fieldname": "cb_delivery",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "lead_time_days",
			"fieldtype": "Int",
			"label": "Lead Time (Days)"
		},
		{
			"fieldname": "listing",
			"fieldtype": "Link",
			"label": "Listing",
			"options": "Listing",
			"description": "Satıcının önerdiği ürün"
		},
		{
			"fieldname": "listing_title",
			"fieldtype": "Data",
			"label": "Listing Title",
			"read_only": 1,
			"hidden": 1
		},
		{
			"fieldname": "listing_image",
			"fieldtype": "Data",
			"label": "Listing Image",
			"read_only": 1,
			"hidden": 1
		},
		{
			"fieldname": "is_seen_by_buyer",
			"fieldtype": "Check",
			"label": "Seen by Buyer",
			"default": "0",
			"read_only": 1,
			"hidden": 1
		},
		{
			"fieldname": "tab_message",
			"fieldtype": "Tab Break",
			"label": "Message"
		},
		{
			"fieldname": "message",
			"fieldtype": "Text",
			"label": "Message"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"report": 1,
			"export": 1
		},
		{
			"role": "Marketplace Admin",
			"read": 1,
			"write": 1,
			"create": 1,
			"report": 1
		},
		{
			"role": "Seller",
			"read": 1,
			"write": 1,
			"create": 1,
			"if_owner": 1
		},
		{
			"role": "Buyer",
			"read": 1
		}
	],
	"actions": [],
	"links": [],
	"states": []
}
