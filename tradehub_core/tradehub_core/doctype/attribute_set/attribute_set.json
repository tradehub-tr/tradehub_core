  "tab_general",
  "sb_identity",
  "set_code",
  "set_name",
  "is_active",
  "column_break_1",
  "scope",
  "parent_attribute_set",
  "sort_order",
  "sb_desc",
  "description",
  "tab_groups",
  "sb_groups",
  "groups",
  "tab_items",
  "sb_items",
  "items",
  "tab_mapping",
  "sb_mapping",
  "category_mappings"
 ],
 "fields": [
  {"fieldname": "tab_general", "fieldtype": "Tab Break", "label": "Genel"},
  {"fieldname": "sb_identity", "fieldtype": "Section Break", "label": "Kimlik"},
  {"fieldname": "set_code", "fieldtype": "Data", "label": "Set Kodu", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "set_name", "fieldtype": "Data", "label": "Set Adı", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Aktif", "default": "1", "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "scope", "fieldtype": "Select", "label": "Kapsam", "options": "Category\nProduct Type\nFamily\nGlobal", "default": "Category", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "parent_attribute_set", "fieldtype": "Link", "label": "Üst Set", "options": "Attribute Set", "description": "Inheritance için"},
  {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sıralama", "default": "0"},
  {"fieldname": "sb_desc", "fieldtype": "Section Break", "label": "Açıklama"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Açıklama"},
  {"fieldname": "tab_groups", "fieldtype": "Tab Break", "label": "Gruplar"},
  {"fieldname": "sb_groups", "fieldtype": "Section Break", "label": "Attribute Grupları"},
  {"fieldname": "groups", "fieldtype": "Table", "label": "Gruplar", "options": "Attribute Set Group"},
  {"fieldname": "tab_items", "fieldtype": "Tab Break", "label": "Attribute'ler"},
  {"fieldname": "sb_items", "fieldtype": "Section Break", "label": "Attribute Listesi"},
  {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "Attribute Set Item"},
  {"fieldname": "tab_mapping", "fieldtype": "Tab Break", "label": "Eşleme"},
  {"fieldname": "sb_mapping", "fieldtype": "Section Break", "label": "Kategori Eşlemesi"},
  {"fieldname": "category_mappings", "fieldtype": "Table", "label": "Kategoriler", "options": "Attribute Set Category Map"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1, "report": 1, "share": 1, "print": 1, "email": 1},
  {"role": "Marketplace Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "Seller", "read": 1, "report": 1, "export": 1},
  {"role": "Marketplace Seller", "read": 1},
  {"role": "All", "read": 1}
 ]
}
