{
	"name": "Role Delegation",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Autoincrement",
	"autoname": "format:RD-{####}",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"fields": [
		{
			"fieldname": "delegator",
			"fieldtype": "Link",
			"label": "Delegator (Devreden)",
			"options": "User",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "delegate",
			"fieldtype": "Link",
			"label": "Delegate (Alıcı)",
			"options": "User",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "role",
			"fieldtype": "Link",
			"label": "Role",
			"options": "Role",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "cb_meta",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "tenant",
			"fieldtype": "Link",
			"label": "Tenant",
			"options": "Admin Seller Profile",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "pending\nactive\nexpired\nrevoked",
			"default": "pending",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "auto_revoke",
			"fieldtype": "Check",
			"label": "Auto-Revoke on Expiry",
			"default": 1
		},
		{
			"fieldname": "sb_period",
			"fieldtype": "Section Break",
			"label": "Validity"
		},
		{
			"fieldname": "starts_at",
			"fieldtype": "Datetime",
			"label": "Starts At",
			"reqd": 1
		},
		{
			"fieldname": "ends_at",
			"fieldtype": "Datetime",
			"label": "Ends At",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "sb_approval",
			"fieldtype": "Section Break",
			"label": "Approval"
		},
		{
			"fieldname": "approved_by",
			"fieldtype": "Link",
			"label": "Approved By",
			"options": "User"
		},
		{
			"fieldname": "approved_at",
			"fieldtype": "Datetime",
			"label": "Approved At"
		},
		{
			"fieldname": "sb_notes",
			"fieldtype": "Section Break",
			"label": "Reason"
		},
		{
			"fieldname": "reason",
			"fieldtype": "Small Text",
			"label": "Reason / Notes"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "share": 1
		},
		{
			"role": "Compliance Officer",
			"read": 1, "report": 1
		},
		{
			"role": "Seller Owner",
			"read": 1, "write": 1, "create": 1
		}
	]
}
