{
    "name": "Consent Policy Version",
    "doctype": "DocType",
    "module": "Tradehub Core",
    "naming_rule": "By fieldname",
    "autoname": "format:CPV-{policy_type}-{version}",
    "engine": "InnoDB",
    "track_changes": 1,
    "sort_field": "effective_date",
    "sort_order": "DESC",
    "fields": [
        {"fieldname": "policy_type", "fieldtype": "Select", "label": "Policy Type", "options": "privacy_policy\nterms_of_service\nkvkk_disclosure", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "version", "fieldtype": "Data", "label": "Version", "reqd": 1, "in_list_view": 1, "description": "e.g. v2.1"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nActive\nSuperseded", "default": "Draft", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "cb_dates", "fieldtype": "Column Break"},
        {"fieldname": "effective_date", "fieldtype": "Date", "label": "Effective Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "requires_re_consent", "fieldtype": "Check", "label": "Requires Re-consent", "default": 0, "description": "Bu versiyon kullanıcılardan onay yenilemesi gerektiriyor mu"},
        {"fieldname": "content_hash", "fieldtype": "Data", "label": "Content Hash", "read_only": 1, "description": "SHA256 hash — içerik değişikliği tespiti"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1},
        {"role": "Compliance Officer", "read": 1, "write": 1, "create": 1, "export": 1}
    ]
}
