{
	"name": "Addresses",
	"doctype": "DocType",
	"module": "Tradehub Core",
	"naming_rule": "Expression",
	"autoname": "ADDR-.####",
	"engine": "InnoDB",
	"track_changes": 1,
	"sort_field": "modified",
	"sort_order": "DESC",
	"fields": [
		{
			"fieldname": "kind",
			"fieldtype": "Select",
			"label": "Tür (DEPRECATED)",
			"options": "Buyer\nSeller",
			"default": "Buyer",
			"in_list_view": 1,
			"in_standard_filter": 1,
			"search_index": 1,
			"description": "Sprint 1 (2026-05-15): purpose alanına taşındı. Geçiş penceresinde yazılmaya devam ediyor. Sprint 4'te drop."
		},
		{
			"fieldname": "purpose",
			"fieldtype": "Select",
			"label": "Amaç",
			"options": "Delivery\nPickup\nBilling",
			"default": "Delivery",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"search_index": 1,
			"description": "Sprint 1 (2026-05-15): amaç-bazlı ayrım — kind (rol-bazlı) yerine. Delivery=alıcıya gelsin, Pickup=satıcı buradan göndersin, Billing=fatura adresi."
		},
		{
			"fieldname": "address_type",
			"fieldtype": "Select",
			"label": "Adres Tipi",
			"options": "Individual\nBusiness",
			"default": "Individual",
			"reqd": 1,
			"in_standard_filter": 1,
			"description": "Bireysel / Kurumsal. Business ise tax_no + tax_office zorunlu (Marketplace Settings.require_tax_id_business)."
		},
		{
			"fieldname": "tax_no",
			"fieldtype": "Data",
			"label": "Vergi No (VKN/TCKN)",
			"mandatory_depends_on": "eval:doc.address_type=='Business'",
			"description": "Kurumsal adres için VKN (10 hane, Maliye checksum)."
		},
		{
			"fieldname": "tax_office",
			"fieldtype": "Data",
			"label": "Vergi Dairesi",
			"mandatory_depends_on": "eval:doc.address_type=='Business'"
		},
		{
			"fieldname": "user",
			"fieldtype": "Link",
			"label": "User",
			"options": "User",
			"depends_on": "eval:doc.kind=='Buyer'",
			"mandatory_depends_on": "eval:doc.kind=='Buyer'",
			"search_index": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "seller",
			"fieldtype": "Link",
			"label": "Seller Store",
			"options": "Admin Seller Profile",
			"depends_on": "eval:doc.kind=='Seller'",
			"mandatory_depends_on": "eval:doc.kind=='Seller'",
			"search_index": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"description": "Sprint 2 - User Profile birleşmesi sonrası Admin Seller Profile'a (mağaza) Link"
		},
		{
			"fieldname": "title",
			"fieldtype": "Data",
			"label": "Adres Başlığı",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "is_default",
			"fieldtype": "Check",
			"label": "Varsayılan Adres",
			"default": "0",
			"in_list_view": 1
		},
		{
			"fieldname": "cb_top",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "contact_name",
			"fieldtype": "Data",
			"label": "İrtibat Kişisi",
			"reqd": 1
		},
		{
			"fieldname": "company",
			"fieldtype": "Data",
			"label": "Şirket Adı",
			"mandatory_depends_on": "eval:doc.address_type=='Business'",
			"description": "Sprint 1 (2026-05-15): reqd=1 kaldırıldı, sadece Business adresleri için zorunlu."
		},
		{
			"fieldname": "sb_contact",
			"fieldtype": "Section Break",
			"label": "İletişim"
		},
		{
			"fieldname": "phone_prefix",
			"fieldtype": "Data",
			"label": "Telefon Kodu",
			"default": "+90"
		},
		{
			"fieldname": "phone",
			"fieldtype": "Data",
			"label": "Telefon",
			"options": "Phone",
			"reqd": 1
		},
		{
			"fieldname": "sb_location",
			"fieldtype": "Section Break",
			"label": "Konum"
		},
		{
			"fieldname": "country",
			"fieldtype": "Data",
			"label": "Ülke Kodu",
			"default": "TR"
		},
		{
			"fieldname": "state",
			"fieldtype": "Data",
			"label": "İl",
			"reqd": 1
		},
		{
			"fieldname": "city",
			"fieldtype": "Data",
			"label": "İlçe"
		},
		{
			"fieldname": "street",
			"fieldtype": "Small Text",
			"label": "Adres Satırı",
			"reqd": 1
		},
		{
			"fieldname": "cb_location",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "apartment",
			"fieldtype": "Data",
			"label": "Daire / Bina"
		},
		{
			"fieldname": "postal_code",
			"fieldtype": "Data",
			"label": "Posta Kodu"
		},
		{
			"fieldname": "note",
			"fieldtype": "Small Text",
			"label": "Adres Notu"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"email": 1,
			"print": 1,
			"report": 1,
			"share": 1,
			"export": 1,
			"import": 1
		},
		{
			"role": "Marketplace Admin",
			"read": 1,
			"write": 1,
			"create": 1,
			"report": 1,
			"export": 1
		},
		{
			"role": "Buyer",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"if_owner": 1
		},
		{
			"role": "Seller",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"if_owner": 1
		}
	],
	"actions": [],
	"links": [],
	"states": []
}
